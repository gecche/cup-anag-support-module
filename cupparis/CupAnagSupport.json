    "policies": {
        "models": {
            "\\App\\Models\\CupAnagSupportContinente": "\\App\\Policies\\CupAnagSupportContinentePolicy",
            "\\App\\Models\\CupAnagSupportAreaMondiale": "\\App\\Policies\\CupAnagSupportAreaMondialePolicy",
            "\\App\\Models\\CupAnagSupportNazione": "\\App\\Policies\\CupAnagSupportNazionePolicy",
            "\\App\\Models\\CupAnagSupportArea": "\\App\\Policies\\CupAnagSupportAreaPolicy",
            "\\App\\Models\\CupAnagSupportRegione": "\\App\\Policies\\CupAnagSupportRegionePolicy",
            "\\App\\Models\\CupAnagSupportProvincia": "\\App\\Policies\\CupAnagSupportProvinciaPolicy",
            "\\App\\Models\\CupAnagSupportComune": "\\App\\Policies\\CupAnagSupportComunePolicy"
        }
    },
    "models": [
        "CupAnagSupportContinente",
