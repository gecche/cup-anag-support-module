    "datafile-providers": [
        "CupAnagSupportComuniIstatXls",
        "CupAnagSupportNazioniIstatXls",
        "CupAnagSupportComuniAggiuntive"
    ],

    "config": [
        "cup-anag-support"
    ],

    "public": [
        "admin/ModelConfs/CupAnagSupportContinente.js",
        "admin/ModelConfs/CupAnagSupportAreaMondiale.js",
        "admin/ModelConfs/CupAnagSupportNazione.js",
        "admin/ModelConfs/CupAnagSupportArea.js",
        "admin/ModelConfs/CupAnagSupportRegione.js",
        "admin/ModelConfs/CupAnagSupportProvincia.js",
        "admin/ModelConfs/CupAnagSupportComune.js",

        "admin/pages/tabgeoitalia.html",
        "admin/pages/tabgeomondo.html",

        "admin/assets/css/cup-anag-support.css",
        "images/vendor/flag-icon-css"
    ],
    "install": [
        "php artisan vendor:publish --provider=\"Gecche\\Cupparis\\App\\Geografiche\\GeoServiceProvider\"",
        "composer dump-autoload",
        "php artisan install-cupparis-package cupparis-app-geografiche",
        "php artisan migrate",
        "php artisan db:seed --class=CupAnagSupportSeeder",
        "ln -s ../../../../vendor/components/flag-icon-css/css/flag-icon.css public/admin/assets/css/flag-icon.css",
        "ln -s ../../../vendor/components/flag-icon-css/flags public/admin/assets/flags"
    ]
}
